{
  "name": "proofline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous paid execution auditor for SAP agents.",
  "scripts": {
    "agent": "tsx apps/agent/src/index.ts",
    "agent:once": "tsx apps/agent/src/index.ts --once",
    "agent:once:no-ace": "tsx apps/agent/src/index.ts --once --no-ace",
    "rpc:check": "tsx apps/agent/src/rpc-check.ts",
    "sap:register": "tsx apps/agent/src/sap-register.ts",
    "sap:publish-tools": "tsx apps/agent/src/sap-publish-tools.ts",
    "sap:discover": "tsx apps/agent/src/sap-discover.ts",
    "sap:payment-plan": "tsx apps/agent/src/sap-payment-plan.ts",
    "sentinel:check": "tsx apps/agent/src/sentinel-check.ts",
    "ace:x402:smoke": "tsx apps/agent/src/ace-x402-smoke.ts",
    "ace:x402:reconcile": "tsx apps/agent/src/reconcile-ace-payments.ts",
    "audit:once": "tsx apps/agent/src/audit-once.ts",
    "proofs:rebuild": "tsx apps/agent/src/audit-once.ts --rebuild-ledger",
    "proofs:verify": "tsx apps/agent/src/verify-proof-signature.ts",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "web:preview": "vite preview --config apps/web/vite.config.ts",
    "web:check": "tsc --project apps/web/tsconfig.json --noEmit",
    "build": "tsc --noEmit && npm run web:check && npm run web:build",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@acedatacloud/x402-client": "^2026.531.5",
    "@oobe-protocol-labs/synapse-sap-sdk": "^0.18.0",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.107.0",
    "dotenv": "^16.4.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "viem": "^2.51.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.16"
  }
}
