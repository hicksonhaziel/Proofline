{
  "buildCommand": "npm run web:build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/x402",
      "destination": "/api/x402"
    },
    {
      "source": "/x402/:path*",
      "destination": "/api/x402"
    },
    {
      "source": "/live/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/proofs",
      "destination": "/index.html"
    },
    {
      "source": "/proofs/:proofId(proof_[^\\.]+)",
      "destination": "/index.html"
    },
    {
      "source": "/payments",
      "destination": "/index.html"
    },
    {
      "source": "/ace",
      "destination": "/index.html"
    },
    {
      "source": "/health",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/agent.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ]
}
