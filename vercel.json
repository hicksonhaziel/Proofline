{
  "buildCommand": "npm run web:build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/x402",
      "destination": "/api/x402"
    },
    {
      "source": "/x402/get_execution_verdict",
      "destination": "/api/x402/get_execution_verdict"
    },
    {
      "source": "/x402/get_execution_proof",
      "destination": "/api/x402/get_execution_proof"
    },
    {
      "source": "/x402/request_fresh_audit",
      "destination": "/api/x402/request_fresh_audit"
    },
    {
      "source": "/x402/list_recent_proofs",
      "destination": "/api/x402/list_recent_proofs"
    },
    {
      "source": "/live/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/proofs",
      "destination": "/index.html"
    },
    {
      "source": "/proofs/:proofId-card.svg",
      "destination": "/api/proofs/proof_card?proofPacketId=:proofId"
    },
    {
      "source": "/proofs/:proofId.json",
      "destination": "/api/proofs/proof_json?proofPacketId=:proofId"
    },
    {
      "source": "/proofs/:proofId(proof_[^\\.]+)",
      "destination": "/index.html"
    },
    {
      "source": "/payments",
      "destination": "/index.html"
    },
    {
      "source": "/ace",
      "destination": "/index.html"
    },
    {
      "source": "/health",
      "destination": "/index.html"
    },
    {
      "source": "/commerce",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/agent.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ]
}
