# Proofline environment template
# Copy to .env.local or .env when implementation begins.
# Do not commit real keys, wallet secrets, or API tokens.

# Solana / Synapse
SOLANA_RPC_URL=
SYNAPSE_RPC_URL=
SAP_KEYPAIR_PATH=/home/hickson/.config/solana/proofline-mainnet.json
SAP_KEYPAIR_JSON=
SAP_KEYPAIR_BASE64=
SENTINEL_AGENT_ID=Ccr2yK3hLALU4p8oNRqrh4dGuvPJTth5KCLMio8cE1ph

# Ace Data Cloud
# Leave ACE_API_KEY empty for bounty x402 mode. Ace API calls will trigger HTTP 402,
# sign X-Payment with ACE_X402_WALLET_KEY, then retry the same request.
ACE_API_KEY=
ACE_X402_WALLET_KEY=
ACE_X402_FACILITATOR_URL=https://facilitator.acedata.cloud

# Proofline runtime
STORAGE_MODE=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
PROOFLINE_PUBLIC_BASE_URL=http://localhost:3000
PROOFLINE_AGENT_URI=
PROOFLINE_X402_ENDPOINT=
AUDIT_INTERVAL_MINUTES=30
TARGET_AGENT_LIST=./data/targets.seed.json

# Safety limits
MAX_SPEND_PER_AUDIT_USDC=0.35
MAX_SPEND_PER_HOUR_USDC=2.00
MAX_SPEND_PER_DAY_USDC=10.00
MIN_REAUDIT_INTERVAL_HOURS=24

# Demo flags
ENABLE_SAP_DISCOVERY=false
ENABLE_SAP_ESCROW=false
ENABLE_ACE_IMAGE=false
ENABLE_ACE_TRANSLATION=true
ENABLE_ACE_AUDIO=false
